# Archivos generados y secretos — nunca se suben a Git
build/
node_modules/
.env
.env.local
.env.*
!.env.example
*.dll
*.exe
*.pdb
*.log

# Datos reales del catalogo (solo para la vista previa local, nunca se suben)
public/datos-reales.json
public/datos-en-vivo.json
revision-datos.json

# Fuentes woff2: se descargan en el build (scripts/descargar-fuentes.js),
# no se guardan en el repo porque el conector no sube binarios
public/fonts/*.woff2
