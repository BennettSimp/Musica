# Copia este archivo como .env (nunca se sube a Git) y pon tus valores reales.
# NUNCA pegues aqui claves reales: este archivo es solo de ejemplo.

# Supabase PostgreSQL. En Render usa la URI del Session pooler (puerto 6543,
# IPv4). La conexion Directa (puerto 5432, IPv6) NO funciona en Render.
DATABASE_URL=postgres://USUARIO:CONTRASEÑA@TU-PROYECTO.pooler.supabase.com:6543/postgres

# Clave de administrador para escribir (POST/PUT/DELETE). Minimo 24 caracteres
# aleatorios. Si no esta definida, CUALQUIERA puede modificar el catalogo.
ADMIN_TOKEN=TU_CLAVE_ADMIN_DE_AL_MENOS_24_CARACTERES_ALEATORIOS

# Origen permitido para CORS. En produccion, el dominio de Vercel:
ALLOWED_ORIGIN=https://musica-plum-psi.vercel.app
# NUNCA en Render ni en producción: ALLOWED_ORIGIN=* solo vale para
# pruebas locales en tu propia máquina. En Render deja el dominio de
# Vercel de arriba; con * cualquiera podría llamar a la API desde
# cualquier origen.
# ALLOWED_ORIGIN=*
